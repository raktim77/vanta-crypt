{
  "name": "vanta-crypt",
  "version": "1.0.4",
  "description": "High-performance binary-safe WebAssembly encryption runtime",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && ./copy-wasm.sh && npm run patch-imports",
    "clean": "rm -rf dist",
    "test": "tsx ../tests/sdk/test_typescript_sdk.ts",
    "patch-imports": "sed -i 's#../wasm/dist/vantacrypt.js#./wasm/vantacrypt.js#g' dist/wrapper.js"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "encryption",
    "typescript",
    "cpp",
    "emscripten"
  ],
  "author": "VantaCrypt",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
